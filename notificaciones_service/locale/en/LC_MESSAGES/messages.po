msgid "Confirmación de cita médica"
msgstr "Medical appointment confirmation"

msgid ""
"Hola %(paciente_nombre)s, tu cita con %(medico_nombre)s "
"(%(especialidad)s) quedó agendada para el %(fecha)s a las %(hora)s."
msgstr ""
"Hello %(paciente_nombre)s, your appointment with %(medico_nombre)s "
"(%(especialidad)s) has been scheduled for %(fecha)s at %(hora)s."
